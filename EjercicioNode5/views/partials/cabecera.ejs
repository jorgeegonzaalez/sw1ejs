<header class="cabecera">
  <a class="logo" href="/">Ejercicio 5</a>
  <% if (usuario) { %>
    <div class="sesion">
      <span>Hola, <strong><%= usuario %></strong></span>
      <form action="/logout" method="post">
        <button type="submit" class="boton boton-secundario">Cerrar sesión</button>
      </form>
    </div>
  <% } else { %>
    <a class="boton" href="/login">Iniciar sesión</a>
  <% } %>
</header>
